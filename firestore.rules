rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 100 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /productGalleries/{productSlug} {
      // Public read access for visitors to see approved 5:4 images (get & list)
      allow read: if true;

      // Write allowed for valid product gallery document slugs
      allow write: if isValidId(productSlug);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
